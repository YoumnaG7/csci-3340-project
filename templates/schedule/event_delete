{% extends "base.html" %}
{% block title %}Delete event{% endblock %}
{% block content %}
<div class="auth">
    <div class="card">
        <p class="eyebrow">Delete event</p>
        <h1 style="font-size:1.5rem">Delete "{{ event.title }}"?</h1>
        <p class="muted">This also removes its comments and can't be undone.</p>
        <form method="post" class="row" style="justify-content:flex-start">{% csrf_token %}
            <button type="submit" class="btn btn-danger" style="width:auto">Yes, delete</button>
            <a href="{% url 'event_detail' event.pk %}" class="btn btn-ghost">Cancel</a>
        </form>
    </div>
</div>
{% endblock %}
