{% extends "base.html" %}
{% block content %}
<div class="card">
  <h2>{{ heading }}</h2>
  <form method="post">{% csrf_token %}
    {% for field in form %}
      <div class="field">
        <label for="{{ field.id_for_label }}"><strong>{{ field.label }}</strong></label>
        {{ field }}
        {% if field.help_text %}<div class="muted">{{ field.help_text }}</div>{% endif %}
        {{ field.errors }}
      </div>
    {% endfor %}
    {{ form.non_field_errors }}
    <button type="submit">Save</button>
  </form>
</div>
{% endblock %}
