{% extends "base.html" %}
{% block title %}{{ heading }}{% endblock %}
{% block content %}
<div class="narrow">
    <div class="page-head">
        <div>
            <p class="eyebrow">Schedule</p>
            <h1>{{ heading }}</h1>
        </div>
    </div>

    <div class="card">
        <form method="post" class="form">{% csrf_token %}
            {% if form.non_field_errors %}<div class="field">{{ form.non_field_errors }}</div>{% endif %}
            {% for field in form %}
                <div class="field field-{{ field.name }}">
                    <label class="lbl" for="{{ field.id_for_label }}">{{ field.label }}</label>
                    {{ field }}
                    {% if field.help_text %}<div class="help">{{ field.help_text }}</div>{% endif %}
                    {{ field.errors }}
                </div>
            {% endfor %}
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save event</button>
                <a href="{% url 'my_schedule' %}" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script>
    // Only show the friend checklist when visibility is "Selected friends".
    const vis = document.getElementById("id_visibility");
    const box = document.querySelector(".field-shared_with");
    function sync() { if (vis && box) box.style.display = vis.value === "selected" ? "" : "none"; }
    if (vis) { vis.addEventListener("change", sync); sync(); }
</script>
{% endblock %}
